ARG UBUNTU_DIST=noble
FROM ubuntu:$UBUNTU_DIST

ARG UBUNTU_DIST
ARG tree_sitter_cli_VERSION
ARG BUILD_VERSION
ARG FULL_VERSION
ARG ARCH
ARG TS_BINARY_DIR
ARG PACKAGE_DEPENDS

RUN mkdir -p /output/usr/bin
RUN mkdir -p /output/usr/share/doc/tree-sitter-cli
RUN mkdir -p /output/usr/share/bash-completion/completions
RUN mkdir -p /output/usr/share/fish/vendor_completions.d
RUN mkdir -p /output/usr/share/zsh/vendor-completions
RUN mkdir -p /output/usr/share/nushell/vendor/autoload
RUN mkdir -p /output/DEBIAN

# The package is named "tree-sitter-cli" (like Debian's) but the command is
# "tree-sitter". The binary is compiled by build_binary.sh (see Dockerfile.build).
COPY ${TS_BINARY_DIR}/tree-sitter /output/usr/bin/tree-sitter
# Completions are generated by build_*.sh from the amd64 binary (they are
# architecture independent) and installed under the BINARY name.
COPY completions/tree-sitter.bash /output/usr/share/bash-completion/completions/tree-sitter
COPY completions/tree-sitter.fish /output/usr/share/fish/vendor_completions.d/tree-sitter.fish
COPY completions/_tree-sitter /output/usr/share/zsh/vendor-completions/_tree-sitter
COPY completions/tree-sitter.nu /output/usr/share/nushell/vendor/autoload/tree-sitter.nu
RUN chmod 755 /output/usr/bin/tree-sitter
# The files copied in from the build host inherit its umask; normalise them
# so the package never ships group-writable files.
RUN chmod 644 /output/usr/share/bash-completion/completions/tree-sitter \
      /output/usr/share/fish/vendor_completions.d/tree-sitter.fish \
      /output/usr/share/zsh/vendor-completions/_tree-sitter \
      /output/usr/share/nushell/vendor/autoload/tree-sitter.nu
COPY output/DEBIAN/control /output/DEBIAN/
COPY output/DEBIAN/postinst /output/DEBIAN/postinst
RUN chmod 755 /output/DEBIAN/postinst
COPY output/copyright /output/usr/share/doc/tree-sitter-cli/
COPY output/changelog.Debian /output/usr/share/doc/tree-sitter-cli/
COPY output/README.md /output/usr/share/doc/tree-sitter-cli/
RUN chmod 644 /output/usr/share/doc/tree-sitter-cli/*

RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/usr/share/doc/tree-sitter-cli/changelog.Debian
RUN sed -i "s/FULL_VERSION/$FULL_VERSION/" /output/usr/share/doc/tree-sitter-cli/changelog.Debian
RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/DEBIAN/control
RUN sed -i "s/tree_sitter_cli_VERSION/$tree_sitter_cli_VERSION/" /output/DEBIAN/control
RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/DEBIAN/control
RUN sed -i "s/SUPPORTED_ARCHITECTURES/$ARCH/" /output/DEBIAN/control
# The binary is glibc-linked; build_*.sh reads the libc6 floor from it.
RUN sed -i "s|^PACKAGE_DEPENDS$|Depends: $PACKAGE_DEPENDS|" /output/DEBIAN/control

RUN dpkg-deb --build /output /tree-sitter-cli_${FULL_VERSION}.deb
